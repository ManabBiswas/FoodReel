MONGODB_URL=mongodb://localhost:27017/name
JWT_SECRET='secretkey'
NODE_ENV=development
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
# Exact origin of the deployed frontend, no trailing slash. This is the CORS
# allowlist, so a mismatch here makes every request from the live site fail.
# Netlify preview deploys get a different origin per branch — add them here if
# you rely on previews.
FRONTEND_URL=http://localhost:5173
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxx
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=52428800
MAX_PROFILE_SIZE=2097152
EMAIL_SERVICE=gmail
EMAIL_USER=yourname@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=FoodReel <yourname@gmail.com>
# Mongo connection tuning (optional)
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000